<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Display -->
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="end|center_vertical"
        android:text="0"
        android:textSize="36sp"
        android:background="#000"
        android:textColor="#FFF"
        android:padding="16dp"/>

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4">

        <!-- Row 1 -->
        <Button android:text="7" android:onClick="onClickNumber"/>
        <Button android:text="8" android:onClick="onClickNumber"/>
        <Button android:text="9" android:onClick="onClickNumber"/>
        <Button android:text="/" android:onClick="onClickOperator"/>

        <!-- Row 2 -->
        <Button android:text="4" android:onClick="onClickNumber"/>
        <Button android:text="5" android:onClick="onClickNumber"/>
        <Button android:text="6" android:onClick="onClickNumber"/>
        <Button android:text="*" android:onClick="onClickOperator"/>

        <!-- Row 3 -->
        <Button android:text="1" android:onClick="onClickNumber"/>
        <Button android:text="2" android:onClick="onClickNumber"/>
        <Button android:text="3" android:onClick="onClickNumber"/>
        <Button android:text="-" android:onClick="onClickOperator"/>

        <!-- Row 4 -->
        <Button android:text="0" android:onClick="onClickNumber"/>
        <Button android:text="AC" android:onClick="onClickClear"/>
        <Button android:text="=" android:onClick="onClickEqual"/>
        <Button android:text="+" android:onClick="onClickOperator"/>

    </GridLayout>

</LinearLayout>